<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         FORM VIEW — Sertifikasi
    ============================================================ -->
    <record id="view_lsp_sertifikasi_form" model="ir.ui.view">
        <field name="name">lsp.sertifikasi.form</field>
        <field name="model">lsp.sertifikasi</field>
        <field name="arch" type="xml">
            <form string="Sertifikasi Kompetensi">
                <header>
                    <button name="action_terbitkan"
                            string="Terbitkan Sertifikat"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="plugins_manajement_asesor.group_admin_lsp"/>

                    <button name="action_cabut"
                            string="Cabut Sertifikat"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'active'"
                            groups="plugins_manajement_asesor.group_admin_lsp"/>

                    <button name="action_set_draft"
                            string="Reset ke Draft"
                            type="object"
                            invisible="state != 'active'"
                            groups="plugins_manajement_asesor.group_admin_lsp"/>

                    <button name="action_print_sertifikat"
                            string="Cetak Sertifikat (PDF)"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('active', 'expired')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="nomor_sertifikat" string="Nomor Sertifikat"/>
                        <h1>
                            <field name="nomor_sertifikat"
                                   readonly="1"
                                   placeholder="Auto-generate saat disimpan"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Data Asesi">
                            <field name="student_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="asesmen_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="skema_id" readonly="1"/>
                            <field name="asesor_id" readonly="1"/>
                        </group>
                        <group string="Masa Berlaku">
                            <field name="tanggal_terbit"
                                   readonly="state != 'draft'"/>
                            <field name="masa_berlaku_tahun"
                                   readonly="state != 'draft'"/>
                            <field name="tanggal_kadaluarsa" readonly="1"/>
                        </group>
                    </group>

                    <!-- QR Code & Verifikasi -->
                    <group string="Verifikasi Digital" invisible="state == 'draft'">
                        <group>
                            <field name="verification_url" readonly="1" widget="url"/>
                        </group>
                        <group>
                            <field name="qr_code"
                                   widget="image"
                                   readonly="1"
                                   options="{'size': [150, 150]}"/>
                        </group>
                    </group>

                    <!-- Alasan Pencabutan -->
                    <group string="Pencabutan" invisible="state != 'revoked'">
                        <field name="alasan_cabut" readonly="1" nolabel="1"/>
                    </group>

                    <!-- Catatan -->
                    <notebook>
                        <page string="Catatan">
                            <field name="catatan"
                                   placeholder="Catatan tambahan..."
                                   readonly="state not in ('draft',)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         LIST VIEW — Sertifikasi
    ============================================================ -->
    <record id="view_lsp_sertifikasi_tree" model="ir.ui.view">
        <field name="name">lsp.sertifikasi.tree</field>
        <field name="model">lsp.sertifikasi</field>
        <field name="arch" type="xml">
            <list string="Daftar Sertifikat"
                  decoration-danger="state == 'revoked'"
                  decoration-muted="state == 'expired'"
                  decoration-success="state == 'active'">
                <field name="nomor_sertifikat"/>
                <field name="student_id"/>
                <field name="skema_id"/>
                <field name="asesor_id"/>
                <field name="tanggal_terbit"/>
                <field name="tanggal_kadaluarsa"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'revoked'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         SEARCH VIEW — Sertifikasi
    ============================================================ -->
    <record id="view_lsp_sertifikasi_search" model="ir.ui.view">
        <field name="name">lsp.sertifikasi.search</field>
        <field name="model">lsp.sertifikasi</field>
        <field name="arch" type="xml">
            <search string="Cari Sertifikat">
                <field name="nomor_sertifikat" string="Nomor Sertifikat"/>
                <field name="student_id" string="Nama Asesi"/>
                <field name="skema_id" string="Skema"/>

                <filter string="Aktif" name="aktif"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Kadaluarsa" name="expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Dicabut" name="revoked"
                        domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <group>
                    <filter string="Skema" name="group_skema"
                            context="{'group_by': 'skema_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Bulan Terbit" name="group_bulan"
                            context="{'group_by': 'tanggal_terbit:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         KANBAN VIEW — Sertifikasi
    ============================================================ -->
    <record id="view_lsp_sertifikasi_kanban" model="ir.ui.view">
        <field name="name">lsp.sertifikasi.kanban</field>
        <field name="model">lsp.sertifikasi</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column">
                <field name="nomor_sertifikat"/>
                <field name="student_id"/>
                <field name="skema_id"/>
                <field name="tanggal_kadaluarsa"/>
                <field name="state"/>
                <field name="qr_code"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="nomor_sertifikat"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><b>Asesi:</b> <field name="student_id"/></div>
                                <div><b>Skema:</b> <field name="skema_id"/></div>
                                <div><b>Berlaku s/d:</b> <field name="tanggal_kadaluarsa"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
         ACTION
    ============================================================ -->
    <record id="action_lsp_sertifikasi" model="ir.actions.act_window">
        <field name="name">Sertifikasi</field>
        <field name="res_model">lsp.sertifikasi</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_lsp_sertifikasi_search"/>
        <field name="context">{'search_default_aktif': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada sertifikat yang diterbitkan.
            </p>
            <p>
                Sertifikat akan dibuat secara otomatis saat hasil asesmen asesi berstatus Lulus (Kompeten).
            </p>
        </field>
    </record>

    <!-- ============================================================
         WIZARD VIEW — Pencabutan
    ============================================================ -->
    <record id="view_lsp_sertifikasi_cabut_wizard_form" model="ir.ui.view">
        <field name="name">lsp.sertifikasi.cabut.wizard.form</field>
        <field name="model">lsp.sertifikasi.cabut.wizard</field>
        <field name="arch" type="xml">
            <form string="Konfirmasi Pencabutan Sertifikat">
                <group>
                    <field name="sertifikasi_id" readonly="1"/>
                    <field name="alasan_cabut" required="1"
                           placeholder="Masukkan alasan pencabutan sertifikat..."/>
                </group>
                <footer>
                    <button name="action_konfirmasi_cabut"
                            string="Cabut Sertifikat"
                            type="object"
                            class="btn-danger"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>